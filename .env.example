# Supabase（Project Settings → API）※ service_role キーはサーバー専用。絶対に公開しないこと
SUPABASE_URL=https://filtkadnvdhjkkiawiiz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# セッション署名用（32 文字以上のランダム文字列: `openssl rand -base64 48`）
SESSION_SECRET=

# LINE Messaging API チャネル（公式 LINE）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE ログインチャネル（LIFF アプリを作成したチャネル）
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# 公式 LINE の友だち追加 URL（管理画面に表示し、検査員募集の案内に使用。例: https://lin.ee/xxxx）
LINE_ADD_FRIEND_URL=

# アプリの URL（LIFF ID 未設定時のリンク用。例: https://eisei-kensa.vercel.app）
APP_BASE_URL=

# Google マップ（任意）
# 交通費（車）の「経路検索して距離を反映」に使用。Routes API を有効化したサーバー用キー
GOOGLE_MAPS_API_KEY=
# 申請画面に経路の地図を表示する場合（Maps Embed API・HTTP リファラー制限をかけたキー）
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
